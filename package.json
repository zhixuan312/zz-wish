{
  "name": "one-light",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch server/main.ts & vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && node scripts/compress.mjs",
    "start": "node server/main.ts",
    "test:tier1": "vitest run tests/tier1/unit && playwright test --config tests/tier1/playwright.config.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:evidence": "node scripts/check-evidence-size.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.160.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
